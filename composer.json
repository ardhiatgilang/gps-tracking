{
    "name": "lacakin/gps-tracking",
    "description": "Sistem Pelacakan GPS LACAKIN - Skripsi",
    "type": "project",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "test-coverage": "phpunit --coverage-html tests/coverage-report --coverage-text=tests/coverage.txt"
    }
}
